{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Allow the two workspace windows to focus and reopen one another",
  "windows": ["config", "monitor"],
  "permissions": ["core:default", "core:webview:allow-create-webview-window", "core:window:allow-show", "core:window:allow-set-focus", "core:window:allow-set-always-on-top"]
}
